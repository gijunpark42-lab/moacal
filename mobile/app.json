{
  "expo": {
    "name": "모아캘",
    "slug": "inbox-calendar",
    "scheme": "inboxcalendar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gijunpark.moacal",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "mailto"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gijunpark.moacal",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "스크린샷과 사진에서 일정을 찾기 위해 사진 접근이 필요합니다."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "찾은 일정을 폰 캘린더에 넣기 위해 캘린더 접근이 필요합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2D6CDF"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "splash": {},
    "extra": {
      "eas": {
        "projectId": "ab64d8b7-5a87-4c95-9cab-9e1217bbe91a"
      }
    },
    "owner": "gijunpark42",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ab64d8b7-5a87-4c95-9cab-9e1217bbe91a"
    }
  }
}
