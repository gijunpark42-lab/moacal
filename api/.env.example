# Anthropic API key (https://platform.claude.com). Put it in .env (gitignored), never here.
ANTHROPIC_API_KEY=

# Claude is called ONLY when this is exactly "1". Leave unset in local dev (fixtures from lib/mock.ts are used).
# Set PARSE_LIVE=1 in the production environment so real users get real parsing.
PARSE_LIVE=

# Optional: shared secret the app must send as x-app-key. Leave empty in local dev.
APP_KEY=

# Optional: override the extraction model
PARSE_MODEL=claude-opus-5

# Gmail OAuth (Google Cloud console, gmail.readonly scope). Leave all empty in local dev: without
# GOOGLE_CLIENT_ID the gmail routes run in mock mode and never contact Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 64 hex chars (32 bytes) used to sign OAuth state and encrypt the refresh token handed to the phone.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_TOKEN_SECRET=
# Where Google redirects back to (must match the OAuth client's redirect URI + /api/gmail/callback).
PUBLIC_BASE_URL=https://inbox-calendar-api.vercel.app
